{
    "bf16": {
      "enabled": true
    },
    "fp16": {
      "enabled": false
    },
    "zero_optimization": {
      "stage": 1,
      "offload_optimizer": {
        "device": "none"
      },
      "offload_param": {
        "device": "none"
      },
      "overlap_comm": true,
      "contiguous_gradients": true
    },
    "optimizer": {
      "type": "AdamW",
      "params": {
        "lr": "auto",
        "betas": "auto",
        "eps": "auto",
        "weight_decay": "auto",
        "torch_adam": true
      }
    },
    "scheduler": {
      "type": "WarmupDecayLR",
      "params": {
        "warmup_min_lr": "auto",
        "warmup_max_lr": "auto",
        "warmup_num_steps": "auto",
        "total_num_steps": "auto"
      }
    },
    "train_micro_batch_size_per_gpu": 4,
    "gradient_accumulation_steps": "auto",
    "steps_per_print": 20,
    "wall_clock_breakdown": false
  }